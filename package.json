{
  "name": "qexo4workers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Qexo rewritten as a Cloudflare Workers-native application",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --config wrangler.prod.toml",
    "db:local": "wrangler d1 migrations apply qexo --local",
    "db:remote": "wrangler d1 migrations apply qexo --remote --config wrangler.prod.toml",
    "test": "node test/e2e.mjs",
    "test:ui": "node test/ui-smoke.mjs",
    "deploy:dry": "wrangler deploy --config wrangler.prod.toml --dry-run",
    "test:prod": "node test/prod-smoke.mjs"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.162.0",
    "yaml": "^2.9.1"
  }
}
